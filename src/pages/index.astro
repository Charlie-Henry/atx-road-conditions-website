---
import "@fontsource/overpass/400.css";
import "@fontsource/overpass/600.css";
import "@fontsource/overpass/800.css";
import "../styles/global.css";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Austin road conditions</title>
    <meta
      name="description"
      content="Current road surface conditions at Austin road sensors, with a traffic camera view for each."
    />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  </head>
  <body>
    <div class="app">
      <header class="masthead">
        <div class="masthead__text">
          <h1>Austin road conditions</h1>
          <p>
            Road surface readings from automated sensors, sourced from the{" "}
            <a href="https://data.austintexas.gov/Transportation-and-Mobility/Real-Time-Road-Conditions/ypbq-i42h/about_data">City of Austin</a>
          </p>
        </div>
        <a
          class="masthead__link"
          href="https://bsky.app/profile/atx-road-condition.bsky.social"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 22" width="18" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/></svg>
          <span class="masthead__link-text">Updates on Bluesky<span class="visually-hidden"> (opens in a new tab)</span></span>
        </a>
      </header>

      <section class="panel" aria-labelledby="sensors-heading">
        <h2 id="sensors-heading" class="visually-hidden">Sensors</h2>
        <p id="banner" class="banner" role="status" hidden></p>
        <ol id="sensor-list" class="sensor-list"></ol>
        <div id="outdated-filter" class="outdated-filter" hidden>
          <p id="outdated-note"></p>
          <button id="toggle-outdated" class="btn" type="button">Show outdated sites</button>
        </div>
        <div class="layers">
          <label class="layer-toggle">
            <input id="toggle-incidents" type="checkbox" />
            <span class="incident-key" aria-hidden="true"><svg viewBox="0 0 22 22" aria-hidden="true" focusable="false"><rect x="9.6" y="4.3" width="2.8" height="8.4" rx="1.4"/><circle cx="11" cy="16.2" r="1.7"/></svg></span>
            <span id="incidents-label">Traffic incidents</span>
          </label>
          <p class="layer-note">
            Active incidents from the{" "}
            <a href="https://data.austintexas.gov/Transportation-and-Mobility/Real-Time-Traffic-Incident-Reports/dx9v-zd7x">City of Austin</a>
          </p>
        </div>
        <div class="panel__foot">
          <span id="checked">Loading readings…</span>
          <button id="refresh" class="btn" type="button">Refresh now</button>
        </div>
      </section>

      <main class="map-wrap">
        <div id="map" role="region" aria-label="Map of road condition sensors"></div>
        <div id="alerts" class="alerts" role="region" aria-label="Weather alerts" aria-live="polite"></div>
      </main>

      <footer class="site-footer">
        <p>
          This is not an official City of Austin website. Personal project by{" "}
          <a href="https://charliehenry.ch/">Charlie Henry</a>.
        </p>
      </footer>
    </div>

    <div id="loading" class="loading" role="status" aria-live="polite">
      <div class="loading__box">
        <img class="loading__sign" src={`${base}logo-sign.png`} alt="" width="64" height="64" />
        <h2 class="loading__title">Loading road conditions</h2>
        <div class="loading__road" aria-hidden="true"></div>
        <ul class="loading__steps">
          <li data-step="sensors" data-state="pending">
            <span class="step__icon" aria-hidden="true"></span>
            <span class="step__label">Road sensors</span>
            <span class="step__state">Checking…</span>
          </li>
          <li data-step="incidents" data-state="pending">
            <span class="step__icon" aria-hidden="true"></span>
            <span class="step__label">Traffic incidents</span>
            <span class="step__state">Checking…</span>
          </li>
        </ul>
        <p id="loading-slow" class="loading__slow" hidden>Still working. The open data portal can be slow.</p>
      </div>
    </div>

    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
